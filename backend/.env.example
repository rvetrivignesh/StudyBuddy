# ---------- App ----------
ENV=dev
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---------- MongoDB ----------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=study_companion

# ---------- Qdrant (vector store for RAG) ----------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=study_chunks
EMBEDDING_DIM=768          # must match the embedding model (nomic-embed-text = 768)

# ---------- Ollama (local models) ----------
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Model per task (LiteLLM model strings) ----------
# Local:   ollama_chat/<model>     Hosted:  groq/<model>, gemini/<model>, ...
# Check the Ollama library / provider docs for current model names.
MODEL_CHAT=ollama_chat/qwen3:8b
MODEL_DEEP_LEARNING=ollama_chat/qwen3:8b
MODEL_FLASHCARDS=ollama_chat/qwen3:4b
MODEL_RECALL_MCQ=ollama_chat/qwen3:8b
MODEL_GRADING=ollama_chat/qwen3:8b
MODEL_PLANNER=ollama_chat/qwen3:8b
MODEL_SYLLABUS=ollama_chat/qwen3:8b
MODEL_RESUME_PARSE=ollama_chat/qwen3:8b
MODEL_RESUME_ANALYZE=ollama_chat/qwen3:8b
MODEL_EMBEDDING=ollama/nomic-embed-text

# ---------- Optional hosted-model keys (free tiers) ----------
# GROQ_API_KEY=
# GEMINI_API_KEY=
# Example override to move heavy tasks to a hosted model:
# MODEL_DEEP_LEARNING=gemini/gemini-2.5-flash
# MODEL_GRADING=groq/llama-3.3-70b-versatile

# ---------- Speech-to-text (needs requirements-extra.txt) ----------
WHISPER_MODEL=small
